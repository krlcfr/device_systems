# device_systems - Variables de Entorno
# Copia este archivo como .env y ajusta los valores

# Clave secreta para firmar los tokens JWT
# En produccion, usa una clave fuerte generada con: openssl rand -hex 32
SECRET_KEY=device-systems-secret-key-cambiar-en-produccion

# URL de la base de datos
DATABASE_URL=sqlite:///./device_systems.db

# Tiempo de expiracion del token JWT en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30
